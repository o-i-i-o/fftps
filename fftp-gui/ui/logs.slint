// 日志页：实时订阅 + 级别过滤 + 文本搜索 + 文件历史
//
// 实时条目由 Rust 经日志流桥接追加到 entries 模型（内存环形缓冲
// 上限 5000 条在 Rust 侧）；级别过滤/搜索变更时由 Rust 重建模型；
// 自动滚动由 viewport-height 变化驱动（仅实时视图且开关开启）。

import { Theme, LogRow } from "common.slint";
import { Button, CheckBox, ComboBox, LineEdit, ListView } from "std-widgets.slint";

// 日志页状态（Rust 侧驱动）
export global LogsState {
    // 展示条目（已过滤快照）
    in property <[LogRow]> entries;
    in property <int> count;
    in property <bool> viewing-file;
    in property <string> error;
    in property <string> info;
    // 工具栏
    in-out property <int> filter-idx;
    in-out property <string> search;
    in-out property <bool> auto-scroll;
    // 文件历史
    in property <[string]> file-names;
    in-out property <int> file-idx;
    // 滚动偏移（自动滚动写回）
    in-out property <length> scroll-y;
    callback clear();
    callback copy();
    callback export();
    callback load-file();
    callback back-live();
    callback refresh-files();
    callback select-file(int);
    callback filter-changed();
    callback search-changed();
}

export component LogsPage inherits VerticalLayout {
    spacing: 10px;

    Text { text: "日志"; font-size: 22px; }

    HorizontalLayout {
        spacing: 10px;
        Text { text: "级别："; font-size: 14px; vertical-alignment: center; }
        ComboBox {
            min-width: 110px;
            model: ["全部", "ERROR", "WARN", "INFO", "DEBUG", "TRACE"];
            current-index <=> LogsState.filter-idx;
            selected => { LogsState.filter-changed(); }
        }
        LineEdit {
            text <=> LogsState.search;
            placeholder-text: "搜索消息/来源/用户/IP";
            min-width: 240px;
            edited => { LogsState.search-changed(); }
        }
        CheckBox { text: "自动滚动"; checked <=> LogsState.auto-scroll; }
        Button { text: "清空"; clicked => { LogsState.clear(); } }
        Button { text: "复制"; clicked => { LogsState.copy(); } }
        Button { text: "导出"; clicked => { LogsState.export(); } }
        Text { text: "显示 " + LogsState.count + " 条"; font-size: 13px; vertical-alignment: center; }
    }

    HorizontalLayout {
        spacing: 10px;
        Text { text: "文件历史："; font-size: 14px; vertical-alignment: center; }
        ComboBox {
            min-width: 220px;
            model: LogsState.file-names;
            current-index <=> LogsState.file-idx;
            enabled: LogsState.file-names.length > 0;
            selected => { LogsState.select-file(self.current-index); }
        }
        Button { text: "加载"; clicked => { LogsState.load-file(); } }
        Button { text: "返回实时"; enabled: LogsState.viewing-file; clicked => { LogsState.back-live(); } }
        Text {
            text: LogsState.viewing-file ? "当前：历史文件" : "当前：实时订阅";
            font-size: 13px;
            color: Theme.accent;
            vertical-alignment: center;
        }
    }

    if LogsState.error != "" : Text { text: LogsState.error; font-size: 13px; color: Theme.error; }
    if LogsState.info != "" : Text { text: LogsState.info; font-size: 13px; color: Theme.info; }

    ListView {
        vertical-stretch: 1;
        content-y <=> LogsState.scroll-y;
        changed content-height => {
            if (LogsState.auto-scroll && !LogsState.viewing-file) {
                LogsState.scroll-y = min(0px, self.height - self.content-height);
            }
        }
        for row in LogsState.entries: Rectangle {
            height: 20px;
            HorizontalLayout {
                spacing: 10px;
                Text { text: row.time; font-size: 12px; color: Theme.muted; min-width: 170px; vertical-alignment: center; }
                Text {
                    text: row.level;
                    font-size: 12px;
                    min-width: 60px;
                    vertical-alignment: center;
                    color: row.level == "ERROR" ? Theme.error : (row.level == "WARN" ? Theme.warn : (row.level == "INFO" ? Theme.info : Theme.muted));
                }
                Text { text: row.source; font-size: 12px; color: Theme.accent; min-width: 110px; overflow: TextOverflow.elide; vertical-alignment: center; }
                Text { text: row.who; font-size: 12px; color: Theme.warn; min-width: 160px; overflow: TextOverflow.elide; vertical-alignment: center; }
                Text { text: row.message; font-size: 12px; horizontal-stretch: 1; overflow: TextOverflow.elide; vertical-alignment: center; }
            }
        }
    }
}
