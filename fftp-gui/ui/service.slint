// 服务页：FTP/SFTP 生命周期 + 系统服务安装/自启 + 日志设置
//
// 状态显示复用 GetStatus（应用壳 5 秒轮询 + 操作后立即刷新）；
// 系统服务管理走平台分支进程调用（Rust 侧），失败把 stderr 显示在页面。

import { Theme } from "common.slint";
import { Button, CheckBox, ComboBox, GroupBox, LineEdit, ScrollView } from "std-widgets.slint";

// 服务页状态（Rust 侧驱动）
export global ServiceState {
    in property <bool> connected;
    in property <bool> busy;
    in property <bool> sys-busy;
    in property <bool> log-saving;
    in property <string> error;
    in property <string> info;
    // 运行状态
    in property <bool> have-status;
    in property <bool> ftp-running;
    in property <bool> sftp-running;
    in property <string> version;
    // 系统服务提示（平台分支文案）
    in property <string> hint;
    // 日志设置
    in-out property <string> log-dir;
    in-out property <int> log-level-idx;
    in-out property <string> max-size;
    in-out property <string> max-files;
    in-out property <bool> gui-logging;
    // which: 0 全部 / 1 FTP / 2 SFTP；action: 0 启动 / 1 停止 / 2 重启
    callback op(int, int);
    // action: 0 安装 / 1 卸载 / 2 自启开 / 3 自启关
    callback sys-op(int);
    callback refresh-status();
    callback reload-log();
    callback save-log();
}

component Card inherits Rectangle {
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 8px;
}

component FormRow inherits HorizontalLayout {
    in property <string> label;
    spacing: 8px;
    Text { text: root.label; font-size: 13px; min-width: 170px; vertical-alignment: center; }
    @children
}

export component ServicePage inherits VerticalLayout {
    spacing: 10px;

    HorizontalLayout {
        spacing: 10px;
        Text { text: "服务"; font-size: 22px; vertical-alignment: center; }
        Button { text: "刷新状态"; enabled: ServiceState.connected && !ServiceState.busy; clicked => { ServiceState.refresh-status(); } }
        if ServiceState.info != "" : Text { text: ServiceState.info; font-size: 13px; color: Theme.info; vertical-alignment: center; }
    }

    if ServiceState.error != "" : Text { text: ServiceState.error; font-size: 13px; color: Theme.error; }

    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 12px;

            Card {
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Text { text: "运行状态"; font-size: 16px; }
                    if ServiceState.have-status : VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "FTP 服务："; font-size: 13px; vertical-alignment: center; }
                            Text { text: ServiceState.ftp-running ? "运行中" : "未运行"; font-size: 13px; color: ServiceState.ftp-running ? Theme.info : Theme.error; vertical-alignment: center; }
                            Text { text: "SFTP 服务："; font-size: 13px; vertical-alignment: center; }
                            Text { text: ServiceState.sftp-running ? "运行中" : "未运行"; font-size: 13px; color: ServiceState.sftp-running ? Theme.info : Theme.error; vertical-alignment: center; }
                        }
                        Text { text: "fftpd 版本：" + ServiceState.version; font-size: 13px; }
                    }
                    if !ServiceState.have-status : Text {
                        text: "尚未获取到状态（未连接 fftpd）";
                        font-size: 13px;
                        color: Theme.muted;
                    }
                }
            }

            GroupBox {
                title: "生命周期管理";
                VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "全部服务"; font-size: 14px; min-width: 120px; vertical-alignment: center; }
                        Button { text: "启动"; enabled: ServiceState.connected && !ServiceState.busy; clicked => { ServiceState.op(0, 0); } }
                        Button { text: "停止"; enabled: ServiceState.connected && !ServiceState.busy; clicked => { ServiceState.op(0, 1); } }
                        Button { text: "重启"; enabled: ServiceState.connected && !ServiceState.busy; clicked => { ServiceState.op(0, 2); } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "FTP 服务"; font-size: 14px; min-width: 120px; vertical-alignment: center; }
                        Button { text: "启动"; enabled: ServiceState.connected && !ServiceState.busy; clicked => { ServiceState.op(1, 0); } }
                        Button { text: "停止"; enabled: ServiceState.connected && !ServiceState.busy; clicked => { ServiceState.op(1, 1); } }
                        Button { text: "重启"; enabled: ServiceState.connected && !ServiceState.busy; clicked => { ServiceState.op(1, 2); } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "SFTP 服务"; font-size: 14px; min-width: 120px; vertical-alignment: center; }
                        Button { text: "启动"; enabled: ServiceState.connected && !ServiceState.busy; clicked => { ServiceState.op(2, 0); } }
                        Button { text: "停止"; enabled: ServiceState.connected && !ServiceState.busy; clicked => { ServiceState.op(2, 1); } }
                        Button { text: "重启"; enabled: ServiceState.connected && !ServiceState.busy; clicked => { ServiceState.op(2, 2); } }
                    }
                }
            }

            GroupBox {
                title: "系统服务（开机自启）";
                VerticalLayout {
                    spacing: 10px;
                    Text { text: ServiceState.hint; font-size: 12px; }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "安装服务"; enabled: !ServiceState.sys-busy; clicked => { ServiceState.sys-op(0); } }
                        Button { text: "卸载服务"; enabled: !ServiceState.sys-busy; clicked => { ServiceState.sys-op(1); } }
                        Button { text: "开机自启：开"; enabled: !ServiceState.sys-busy; clicked => { ServiceState.sys-op(2); } }
                        Button { text: "开机自启：关"; enabled: !ServiceState.sys-busy; clicked => { ServiceState.sys-op(3); } }
                    }
                }
            }

            GroupBox {
                title: "日志设置";
                VerticalLayout {
                    spacing: 8px;
                    FormRow {
                        label: "日志目录 log_dir";
                        LineEdit { text <=> ServiceState.log-dir; placeholder-text: "（空 = 默认目录）"; min-width: 360px; }
                    }
                    FormRow {
                        label: "日志级别";
                        ComboBox {
                            min-width: 160px;
                            model: ["error", "warn", "info", "debug", "trace"];
                            current-index <=> ServiceState.log-level-idx;
                        }
                    }
                    FormRow {
                        label: "单文件大小上限（字节）";
                        LineEdit { text <=> ServiceState.max-size; placeholder-text: "10485760"; min-width: 160px; }
                    }
                    FormRow {
                        label: "轮转保留文件数";
                        LineEdit { text <=> ServiceState.max-files; placeholder-text: "10"; min-width: 160px; }
                    }
                    CheckBox { text: "允许日志实时推送给前端（enable_gui_logging）"; checked <=> ServiceState.gui-logging; }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: ServiceState.log-saving ? "保存中…" : "保存日志设置"; enabled: ServiceState.connected && !ServiceState.log-saving; clicked => { ServiceState.save-log(); } }
                        Button { text: "重新载入"; enabled: ServiceState.connected && !ServiceState.log-saving; clicked => { ServiceState.reload-log(); } }
                    }
                }
            }
        }
    }
}
