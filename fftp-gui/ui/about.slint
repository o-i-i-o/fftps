// 关于页：项目、版本、通信端点与数据路径
//
// 服务端信息以 GetStatus 响应为准；未连接时由 Rust 写入本地可
// 推导的信息（IPC 端点、本机配置/用户库路径）。

import { Theme } from "common.slint";

// 关于页状态（Rust 侧驱动）
export global AboutState {
    in property <string> gui-version;
    in property <string> daemon-version;
    in property <string> endpoint;
    in property <string> config-path;
    in property <string> users-path;
}

component Row inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 8px;
    Text { text: root.label; font-size: 13px; min-width: 170px; vertical-alignment: center; }
    Text { text: root.value; font-size: 13px; overflow: TextOverflow.elide; vertical-alignment: center; }
}

export component AboutPage inherits VerticalLayout {
    spacing: 12px;

    Rectangle {
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 8px;
        VerticalLayout {
            padding: 12px;
            spacing: 6px;
            Text { text: "fftps（f-ftp suite）"; font-size: 26px; }
            Text { text: "跨平台 FTP(FTPS)/SFTP 服务端套件"; font-size: 15px; }
        }
    }

    Rectangle {
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 8px;
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            Text { text: "版本与运行信息"; font-size: 16px; }
            Row { label: "管理程序（fftp-gui）"; value: AboutState.gui-version; }
            Row { label: "服务端（fftpd）"; value: AboutState.daemon-version; }
            Row { label: "IPC 端点"; value: AboutState.endpoint; }
            Row { label: "配置文件"; value: AboutState.config-path; }
            Row { label: "用户库"; value: AboutState.users-path; }
        }
    }

    Text {
        text: "前后端经 fftp-ipc（JSON 帧协议）本地通信：Linux 为 Unix socket（0600），Windows 为命名管道（本地会话 ACL）；fftpd 是配置与用户数据的唯一写入者，管理程序经 IPC 读写。";
        font-size: 12px;
        color: Theme.muted;
        wrap: word-wrap;
    }
}
