// 共享主题色与跨页面结构体
//
// 全部页面统一引用此色板，保证视觉一致。

export global Theme {
    out property <color> error: #f85149;
    out property <color> info: #2ea043;
    out property <color> muted: #8c8c8c;
    out property <color> accent: #5a8cc8;
    out property <color> warn: #d69922;
    out property <color> card: #f6f8fa;
    out property <color> border: #d0d7de;
}

// 实时/历史日志行（logs.slint）
export struct LogRow {
    time: string,
    level: string,
    source: string,
    who: string,
    message: string,
}

// 文件操作审计行（file_logs.slint）
export struct FileOpRow {
    time: string,
    user: string,
    ip: string,
    op: string,
    file: string,
    size: string,
    protocol: string,
    success: bool,
}

// 用户列表行（users.slint）
export struct UserRow {
    username: string,
    enabled: bool,
    admin: bool,
    home: string,
    quota: string,
    limit: string,
}
