// 服务器页：运行状态卡 + FTP/SFTP 结构化表单 + TOML 原文（高级）切换
//
// 表单字段为 in-out 属性（Slint 即表单状态），载入时由 Rust 解析
// config.toml 写入，保存时由 Rust 读回校验后经 IPC 提交。

import { Theme } from "common.slint";
import { Button, CheckBox, ComboBox, GroupBox, LineEdit, ScrollView, TextEdit } from "std-widgets.slint";

// 服务器页状态（Rust 侧驱动）
export global ServerState {
    // 运行状态卡
    in property <bool> have-status;
    in property <bool> ftp-running;
    in property <bool> sftp-running;
    in property <string> version;
    in property <string> config-path;
    in property <string> users-path;
    in property <string> status-endpoint;
    // FTP 表单
    in-out property <bool> ftp-enabled;
    in-out property <string> ftp-bind-ip;
    in-out property <string> ftp-port;
    in-out property <string> ftp-welcome;
    in-out property <bool> ftp-anon;
    in-out property <string> ftp-anon-home;
    in-out property <int> ftp-mode-idx;
    in-out property <string> ftp-passive-start;
    in-out property <string> ftp-passive-end;
    in-out property <bool> ftps-enabled;
    in-out property <bool> ftps-require-ssl;
    in-out property <string> ftps-cert;
    in-out property <string> ftps-key;
    // SFTP 表单
    in-out property <bool> sftp-enabled;
    in-out property <string> sftp-bind-ip;
    in-out property <string> sftp-port;
    in-out property <string> sftp-host-key;
    in-out property <string> sftp-max-auth;
    in-out property <string> sftp-auth-timeout;
    // 高级（原文编辑）
    in-out property <bool> advanced;
    in-out property <string> toml-text;
    // 页面公共
    in property <bool> connected;
    in property <bool> saving;
    in property <string> error;
    in property <string> info;
    callback save();
    callback toggle-advanced();
}

component Card inherits Rectangle {
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 8px;
}

component FormRow inherits HorizontalLayout {
    in property <string> label;
    spacing: 8px;
    Text { text: root.label; font-size: 13px; min-width: 170px; vertical-alignment: center; }
    @children
}

export component ServerPage inherits VerticalLayout {
    spacing: 10px;

    Card {
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            Text { text: "运行状态"; font-size: 16px; }
            if ServerState.have-status : VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "FTP 服务："; font-size: 13px; vertical-alignment: center; }
                    Text { text: ServerState.ftp-running ? "运行中" : "未运行"; font-size: 13px; color: ServerState.ftp-running ? Theme.info : Theme.error; vertical-alignment: center; }
                    Text { text: "SFTP 服务："; font-size: 13px; vertical-alignment: center; }
                    Text { text: ServerState.sftp-running ? "运行中" : "未运行"; font-size: 13px; color: ServerState.sftp-running ? Theme.info : Theme.error; vertical-alignment: center; }
                }
                Text { text: "fftpd 版本：" + ServerState.version; font-size: 13px; }
                Text { text: "配置文件：" + ServerState.config-path; font-size: 13px; overflow: TextOverflow.elide; }
                Text { text: "用户库：" + ServerState.users-path; font-size: 13px; overflow: TextOverflow.elide; }
                Text { text: "IPC 端点：" + ServerState.status-endpoint; font-size: 13px; overflow: TextOverflow.elide; }
            }
            if !ServerState.have-status : Text {
                text: "尚未获取到状态（未连接 fftpd）";
                font-size: 13px;
                color: Theme.muted;
            }
        }
    }

    HorizontalLayout {
        spacing: 8px;
        Text {
            text: ServerState.advanced ? "config.toml（原文编辑）" : "config.toml（结构化表单）";
            font-size: 16px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Button { text: ServerState.advanced ? "返回表单" : "高级：TOML 原文编辑"; clicked => { ServerState.toggle-advanced(); } }
        Button { text: ServerState.saving ? "保存中…" : "保存"; enabled: ServerState.connected && !ServerState.saving; clicked => { ServerState.save(); } }
    }

    if ServerState.error != "" : Text { text: ServerState.error; font-size: 13px; color: Theme.error; }
    if ServerState.info != "" : Text { text: ServerState.info; font-size: 13px; color: Theme.info; }

    if !ServerState.advanced : ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 12px;

            GroupBox {
                title: "FTP 服务";
                VerticalLayout {
                    spacing: 8px;
                    CheckBox { text: "启用 FTP 服务"; checked <=> ServerState.ftp-enabled; }
                    FormRow {
                        label: "监听地址 bind_ip";
                        LineEdit { text <=> ServerState.ftp-bind-ip; placeholder-text: "0.0.0.0"; min-width: 260px; }
                    }
                    FormRow {
                        label: "监听端口 port";
                        LineEdit { text <=> ServerState.ftp-port; placeholder-text: "21"; min-width: 120px; }
                    }
                    FormRow {
                        label: "欢迎消息";
                        LineEdit { text <=> ServerState.ftp-welcome; placeholder-text: "Welcome to fftpd"; min-width: 360px; }
                    }
                    FormRow {
                        label: "连接模式";
                        ComboBox {
                            min-width: 260px;
                            model: ["仅被动 passive_only", "仅主动 active_only", "主动 + 被动 active_and_passive"];
                            current-index <=> ServerState.ftp-mode-idx;
                        }
                    }
                    FormRow {
                        label: "被动端口区间";
                        HorizontalLayout {
                            spacing: 6px;
                            LineEdit { text <=> ServerState.ftp-passive-start; placeholder-text: "50000"; min-width: 110px; }
                            Text { text: "—"; font-size: 13px; vertical-alignment: center; }
                            LineEdit { text <=> ServerState.ftp-passive-end; placeholder-text: "51000"; min-width: 110px; }
                        }
                    }
                    CheckBox { text: "允许匿名登录"; checked <=> ServerState.ftp-anon; }
                    FormRow {
                        label: "匿名主目录";
                        LineEdit { text <=> ServerState.ftp-anon-home; placeholder-text: "（空 = 未设置）"; min-width: 360px; }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        CheckBox { text: "启用 FTPS（显式 TLS）"; checked <=> ServerState.ftps-enabled; }
                        CheckBox { text: "强制 SSL（require_ssl）"; checked <=> ServerState.ftps-require-ssl; }
                    }
                    FormRow {
                        label: "FTPS 证书路径";
                        LineEdit { text <=> ServerState.ftps-cert; placeholder-text: "（空 = 自动生成）"; min-width: 360px; }
                    }
                    FormRow {
                        label: "FTPS 私钥路径";
                        LineEdit { text <=> ServerState.ftps-key; placeholder-text: "（空 = 自动生成）"; min-width: 360px; }
                    }
                }
            }

            GroupBox {
                title: "SFTP 服务";
                VerticalLayout {
                    spacing: 8px;
                    CheckBox { text: "启用 SFTP 服务"; checked <=> ServerState.sftp-enabled; }
                    FormRow {
                        label: "监听地址 bind_ip";
                        LineEdit { text <=> ServerState.sftp-bind-ip; placeholder-text: "0.0.0.0"; min-width: 260px; }
                    }
                    FormRow {
                        label: "监听端口 port";
                        LineEdit { text <=> ServerState.sftp-port; placeholder-text: "2222"; min-width: 120px; }
                    }
                    FormRow {
                        label: "主机密钥路径";
                        LineEdit { text <=> ServerState.sftp-host-key; placeholder-text: "（空 = 默认路径）"; min-width: 360px; }
                    }
                    FormRow {
                        label: "最大认证尝试次数";
                        LineEdit { text <=> ServerState.sftp-max-auth; placeholder-text: "3"; min-width: 120px; }
                    }
                    FormRow {
                        label: "认证超时（秒）";
                        LineEdit { text <=> ServerState.sftp-auth-timeout; placeholder-text: "60"; min-width: 120px; }
                    }
                }
            }
        }
    }

    if ServerState.advanced : TextEdit {
        vertical-stretch: 1;
        text <=> ServerState.toml-text;
    }
}
